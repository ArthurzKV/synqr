{
  "name": "synqr-core",
  "version": "0.1.0",
  "description": "Core CRDT engine with Hybrid Vector Clock",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --external synqr-core --external synqr-types --external synqr-schema --external synqr-sync",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsup": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurzKV/synqr.git"
  },
  "bugs": {
    "url": "https://github.com/ArthurzKV/synqr/issues"
  },
  "homepage": "https://github.com/ArthurzKV/synqr#readme",
  "author": "ArthurzKV",
  "license": "MIT"
}
